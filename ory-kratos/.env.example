# Copy to .env and fill in:  cp .env.example .env
# Generate each secret with:  openssl rand -hex 16   (>= 16 chars; cipher must be exactly 32)

# Signs the session / CSRF cookies.
KRATOS_COOKIE_SECRET=

# Encrypts sensitive values at rest. EXACTLY 32 characters.
KRATOS_CIPHER_SECRET=

# Optional overrides (defaults shown). Keep "localhost" so both apps share the cookie.
# KRATOS_PUBLIC_PORT=4433
# KRATOS_ADMIN_PORT=4434

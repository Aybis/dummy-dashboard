# Copy to .env.local (git-ignored) and fill in. All values are public (VITE_*): never put secrets here.

# Base URL of YOUR Ory identity server (Kratos public API, or Ory Network SDK URL / `ory tunnel` URL).
VITE_KRATOS_URL=

# Public origin of this app. Must be listed in Ory's allowed_return_urls and CORS allowed_origins.
VITE_APP_URL=http://localhost:5174

# Sibling app (only used for the "buka App B" link).
VITE_OTHER_APP_URL=http://localhost:5175/

# Show the sign-up page (true/false).
VITE_REGISTER_ENABLED=true

# Copy to .env.local (git-ignored) and fill in. All values are public (VITE_*): never put secrets here.
# This app is a public SPA client of Thermis (Ory Hydra): Authorization Code + PKCE, no client secret.

# Hydra public URL (the issuer).
VITE_OIDC_ISSUER=http://localhost:4444

# client_id shown in the Thermis portal after creating the application (type SPA).
VITE_OIDC_CLIENT_ID=

# Must match the application's Redirect URIs / Post-logout redirect URIs in the portal exactly.
VITE_OIDC_REDIRECT_URI=http://localhost:5175/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5175/
VITE_OIDC_SCOPE=openid profile email offline_access

# Public origin of this app, and the sibling app (only used for the "buka App B" link).
VITE_APP_URL=http://localhost:5175
VITE_OTHER_APP_URL=http://localhost:5174/

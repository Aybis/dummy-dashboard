# Copy to .env.local (git-ignored) and fill in. All values are public (VITE_*): never put secrets here.

# Thermis / Ory Hydra public URL (the OIDC issuer).
VITE_OIDC_ISSUER=http://localhost:4444

# client_id from the Thermis portal (Applications -> New -> Single-page application).
# A SPA is a public client: there is NO client secret, PKCE protects the code exchange.
VITE_OIDC_CLIENT_ID=

# Scopes to request. Add offline_access only if the application is allowed refresh tokens.
VITE_OIDC_SCOPE=openid profile email

# Public origin of this app. Register in Thermis:
#   redirect URI:              http://localhost:5175/callback
#   post-logout redirect URI:  http://localhost:5175/
#   allowed CORS origin:       http://localhost:5175
VITE_APP_URL=http://localhost:5175

# Optional overrides (default to the values derived from VITE_APP_URL above).
# VITE_OIDC_REDIRECT_URI=http://localhost:5175/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5175/

# Sibling app (only used for the "open App A" link to test SSO).
VITE_OTHER_APP_URL=http://localhost:5174/
